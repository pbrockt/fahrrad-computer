<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Bluetooth LE fuer Pulsgurt (und spaeter Trittfrequenz/Bosch). Bis Android 11
         laeuft der BLE-Scan ueber die alten Rechte plus Standort. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Heimtrainer: das Handy bietet sich Zwift & Co. als Leistungsmesser und Pulsgurt an. -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />

    <!-- GPS-Aufzeichnung. Hintergrund-Standort ist nicht noetig: waehrend der Fahrt laeuft
         ein Vordergrunddienst mit Benachrichtigung. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Abbiegehinweise als Vibration. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Live-Standort per SMS an selbst eingetragene Nummern, nur waehrend einer Fahrt. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- INTERNET fuer Update-Pruefung, Online-Kartenbilder und den Download der Offline-Karten. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Health Connect: Fahrten schreiben, Gewicht lesen. Was hier fehlt, bietet der
         Berechtigungsdialog gar nicht erst an. Trittfrequenz laeuft ueber WRITE_EXERCISE. -->
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE_ROUTE" />
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE" />
    <uses-permission android:name="android.permission.health.WRITE_SPEED" />
    <uses-permission android:name="android.permission.health.WRITE_POWER" />
    <uses-permission android:name="android.permission.health.WRITE_DISTANCE" />
    <uses-permission android:name="android.permission.health.WRITE_ELEVATION_GAINED" />
    <uses-permission android:name="android.permission.health.WRITE_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application
        android:name=".FahrradApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FahrradComputer">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.FahrradComputer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Health Connect (bis Android 13): "Warum braucht die App das?" fuehrt hierher. -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Ab Android 14 verlangt Health Connect diesen Einstieg, sonst erscheint der
             Berechtigungsdialog gar nicht. Fuehrt in die App (Einstellungen erklaeren es). -->
        <activity-alias
            android:name=".ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".recording.RideService"
            android:exported="false"
            android:foregroundServiceType="location|connectedDevice" />

        <service
            android:name=".trainer.TrainerService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Gibt das Update-APK an den Installer und GPX-Dateien zum Teilen frei. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

    <queries>
        <!-- Damit die App erkennt, ob Health Connect installiert ist. -->
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

</manifest>
